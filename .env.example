# ============================================================
# Multi-Agent AI System - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# --- External APIs (all free tiers available) ---
NEWS_API_KEY=your_newsapi_key_here
OPENWEATHER_API_KEY=your_openweathermap_key_here

# --- Email (optional, uses Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# --- Service Ports ---
MCP_SERVER_PORT=8000
NEWS_AGENT_PORT=8001
WEATHER_AGENT_PORT=8002
REPORT_AGENT_PORT=8003
ORCHESTRATOR_PORT=8004
UI_PORT=7860

# --- Service Hosts (use service names in Docker, localhost otherwise) ---
MCP_SERVER_HOST=localhost
NEWS_AGENT_HOST=localhost
WEATHER_AGENT_HOST=localhost
REPORT_AGENT_HOST=localhost
ORCHESTRATOR_HOST=localhost

# --- MCP Transport: sse or stdio ---
MCP_TRANSPORT=sse

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Tracing (optional OpenTelemetry) ---
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# --- App ---
APP_ENV=development
REQUEST_TIMEOUT=30
MAX_RETRIES=3
